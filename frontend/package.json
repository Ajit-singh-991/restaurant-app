{
  "name": "restaurant-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve customer-app",
    "start:customer": "ng serve customer-app --port 4200 --host 0.0.0.0",
    "start:waiter": "ng serve waiter-app --port 4201",
    "start:kitchen": "ng serve kitchen-app --port 4202",
    "start:admin": "ng serve admin-app --port 4203",
    "start:customer:safe": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng serve customer-app --port 4200",
    "start:waiter:safe": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng serve waiter-app --port 4201",
    "start:kitchen:safe": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng serve kitchen-app --port 4202",
    "start:admin:safe": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng serve admin-app --port 4203",
    "build": "npm run build:customer && npm run build:waiter && npm run build:kitchen && npm run build:admin",
    "build:customer": "ng build customer-app --configuration production",
    "build:waiter": "ng build waiter-app --configuration production",
    "build:kitchen": "ng build kitchen-app --configuration production",
    "build:admin": "ng build admin-app --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "cypress:run": "cypress run",
    "e2e": "start-server-and-test start:customer 4200 cypress:run",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@angular/animations": "^17.1.0",
    "@angular/cdk": "^17.1.0",
    "@angular/common": "^17.1.0",
    "@angular/compiler": "^17.1.0",
    "@angular/core": "^17.1.0",
    "@angular/forms": "^17.1.0",
    "@angular/material": "^17.1.0",
    "@angular/platform-browser": "^17.1.0",
    "@angular/platform-browser-dynamic": "^17.1.0",
    "@angular/router": "^17.1.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@stomp/rx-stomp": "^2.0.0",
    "@stomp/stompjs": "^7.0.0",
    "chart.js": "^4.4.1",
    "ng2-charts": "^5.0.0",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.1.0",
    "@angular/cli": "^17.1.0",
    "@angular/compiler-cli": "^17.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/sockjs-client": "^1.5.4",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.3.0",
    "cypress": "^13.6.0",
    "start-server-and-test": "^2.0.3"
  }
}
